{
  "expo": {
    "name": "MES 1.5 Mobile",
    "slug": "mes-1-5-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A281E"
      },
      "package": "com.yramos.mes15mobile",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A281E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4f1a90a4-400a-4236-9fd5-4ccb2d3ccd4d"
      }
    }
  }
}
